{
  "name": "flearn-fullstack",
  "version": "1.0.0",
  "description": "FLEARN Full-Stack Learning Platform",
  "scripts": {
    "dev": "docker-compose up -d",
    "dev:logs": "docker-compose logs -f",
    "stop": "docker-compose down",
    "clean": "docker-compose down -v",
    "build": "docker-compose build",
    "restart": "docker-compose restart",
    "dev:frontend": "cd FLEARN-front && npm run dev",
    "dev:backend": "cd FLEARN-back && npm run dev",
    "install:frontend": "cd FLEARN-front && npm install",
    "install:backend": "cd FLEARN-back && npm install",
    "install:all": "npm run install:frontend && npm run install:backend",
    "test": "npm run test:backend",
    "test:backend": "cd FLEARN-back && npm test",
    "start:prod": "docker-compose -f docker-compose.yml up -d"
  },
  "dependencies": {
    "@types/node": "^24.5.1",
    "@types/react": "^19.1.13",
    "katex": "^0.16.25",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "typescript": "^5.9.2"
  }
}
